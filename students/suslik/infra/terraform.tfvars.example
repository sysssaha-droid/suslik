# Copy to terraform.tfvars for local runs (the file is git-ignored).
# In CI the values come from -var flags and GitHub secrets.

aws_region       = "eu-central-1"
project_name     = "ecotrack"
instance_type    = "t3.micro"
ssh_public_key   = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... replace-me user@example"
ssh_cidr         = "203.0.113.10/32"
app_port         = 8000
root_volume_size = 8
